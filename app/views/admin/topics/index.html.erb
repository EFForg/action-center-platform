<% content_for(:nav) { render "admin/nav" } %>

<% content_for :charts_js do %>
  <%= javascript_pack_tag "admin_topics" %>
<% end %>

<p>Congress topics are used to pre-fill reasonable defaults for the e-mail tool.  You can assign a topic category to e-mail actions to make it quicker and easier for end users to e-mail their reps.  Dragging a row up or down changes the priority or "tier" for the topics.</p>

<div class="topic-category-tables-root">
  <%= react_component("TopicCategoryTables", props: topic_category_tables_props) %>
</div>
